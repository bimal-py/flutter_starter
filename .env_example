# Copy this file to `.env` and fill in real values.
# Do NOT commit `.env` (it's gitignored).
#
# WARNING: anything in `.env` ships inside the compiled app binary and can be
# extracted from an IPA/APK. Use this for OAuth client IDs, API base URLs, and
# ad unit IDs — NOT for real secrets. Real secrets must live behind your backend.

# ── Firebase ─────────────────────────────────────────────────────────────────
# Set to true to enable Crashlytics / Analytics in release builds.
# Requires lib/firebase_options.dart (generated by `flutterfire configure`).
FIREBASE_ENABLED=false

# ── Networking ────────────────────────────────────────────────────────────────
# Base URL for your REST API (include trailing slash if your endpoints don't
# start with /). Leave blank if the app has no HTTP backend.
API_BASE_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Arbitrary backend auth key used by your AuthRepository implementation.
# Release builds pick PROD_*; debug and profile builds pick DEV_*.
DEV_AUTH_KEY=
PROD_AUTH_KEY=

# Google Sign-In — server-side client ID from Google Cloud Console.
# Needed only when you implement loginWithGoogle().
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In — only needed when you implement loginWithApple().
APPLE_CLIENT_ID=
APPLE_REDIRECT_URL=

# ── Google Mobile Ads ─────────────────────────────────────────────────────────
# Get test IDs from https://developers.google.com/admob/android/test-ads
# Release builds pick PROD_*; debug and profile builds pick DEV_*.
# Remove this section (and lib/modules/mobile_ads/) if not using ads.

# App Open
DEV_ANDROID_APP_OPEN_AD_UNIT_ID=
PROD_ANDROID_APP_OPEN_AD_UNIT_ID=
DEV_IOS_APP_OPEN_AD_UNIT_ID=
PROD_IOS_APP_OPEN_AD_UNIT_ID=

# Banner
DEV_ANDROID_BANNER_AD_UNIT_ID=
PROD_ANDROID_BANNER_AD_UNIT_ID=
DEV_IOS_BANNER_AD_UNIT_ID=
PROD_IOS_BANNER_AD_UNIT_ID=

# Interstitial
DEV_ANDROID_INTERSTITIAL_AD_UNIT_ID=
PROD_ANDROID_INTERSTITIAL_AD_UNIT_ID=
DEV_IOS_INTERSTITIAL_AD_UNIT_ID=
PROD_IOS_INTERSTITIAL_AD_UNIT_ID=

# Rewarded
DEV_ANDROID_REWARDED_AD_UNIT_ID=
PROD_ANDROID_REWARDED_AD_UNIT_ID=
DEV_IOS_REWARDED_AD_UNIT_ID=
PROD_IOS_REWARDED_AD_UNIT_ID=

# Rewarded Interstitial
DEV_ANDROID_REWARDED_INTERSTITIAL_AD_UNIT_ID=
PROD_ANDROID_REWARDED_INTERSTITIAL_AD_UNIT_ID=
DEV_IOS_REWARDED_INTERSTITIAL_AD_UNIT_ID=
PROD_IOS_REWARDED_INTERSTITIAL_AD_UNIT_ID=

# Native
DEV_ANDROID_NATIVE_AD_UNIT_ID=
PROD_ANDROID_NATIVE_AD_UNIT_ID=
DEV_IOS_NATIVE_AD_UNIT_ID=
PROD_IOS_NATIVE_AD_UNIT_ID=
