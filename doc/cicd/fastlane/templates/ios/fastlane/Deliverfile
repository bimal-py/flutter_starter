# TEMPLATE (not wired into this project). Copy to ios/fastlane/Deliverfile
# AFTER the first `fastlane deliver init` (init refuses to run, or overwrites,
# when a Deliverfile is already there; see doc/cicd/fastlane/README.md).
#
# Configuration for `deliver`, the App Store listing tool.

# --- Sign-in ---------------------------------------------------------------
# App Store Connect API key, so runs need no Apple ID password and no 2FA.
# The JSON holds key_id, issuer_id, key (the .p8 text) and in_house. It is
# gitignored: never commit it. The path is relative to ios/.
api_key_path("fastlane/appstore_api_key.json")

# --- What gets uploaded ----------------------------------------------------
# Listing only. Builds reach App Store Connect through CI (doc/cicd/codemagic/).
skip_binary_upload(true)

# Text:        fastlane/metadata/<locale>/*.txt, plus the files directly in
#              fastlane/metadata/ (copyright, categories) and
#              fastlane/metadata/review_information/.
# Screenshots: fastlane/screenshots/<locale>/. deliver works out each image's
#              device from its pixel size, so one flat folder per locale.
# overwrite_screenshots deletes a locale's screenshots in App Store Connect
# before uploading the local set, so the local folder is the whole truth.
overwrite_screenshots(true)

# precheck can't inspect in-app purchases with API-key sign-in, and nothing
# is submitted from here anyway.
run_precheck_before_submit(false)

# --- Safety ----------------------------------------------------------------
# Changes land on the editable version as a draft. You review them in App
# Store Connect and submit the version yourself.
submit_for_review(false)
automatic_release(false)
